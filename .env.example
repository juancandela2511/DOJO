# ==============================================================================
# ARCHIVO DE CONFIGURACIÓN DE VARIABLES DE ENTORNO (.env.example)
# Sistema Híbrido de Gestión de Dojo - Arquitectura de Microservicios
# Instrucciones: Copia este archivo como `.env` en la raíz del proyecto
# Comando: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CONFIGURACIÓN GENERAL Y ENTORNO
# ------------------------------------------------------------------------------
# Entorno de ejecución: development | production | test
NODE_ENV=development
# Zona horaria del Dojo para cálculos de mensualidades y asistencia diaria
TZ=America/Bogota

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS POSTGRESQL (CONTENEDOR CENTRAL)
# ------------------------------------------------------------------------------
# Host del servicio dentro de la red de Docker Compose
POSTGRES_HOST=dojo-postgres
# Puerto interno/externo expuesto por PostgreSQL
POSTGRES_PORT=5432
# Nombre de la base de datos principal del Dojo
POSTGRES_DB=dojo_management_db
# Usuario administrador de la base de datos
POSTGRES_USER=dojo_admin
# Contraseña segura de PostgreSQL (Cambiar en producción)
POSTGRES_PASSWORD=DojoSuperSecretDbPass2026!
# URL de conexión completa utilizada por los microservicios
DATABASE_URL=postgresql://dojo_admin:DojoSuperSecretDbPass2026!@dojo-postgres:5432/dojo_management_db

# ------------------------------------------------------------------------------
# 3. SEGURIDAD, JWT Y SESIONES PERSISTENTES
# ------------------------------------------------------------------------------
# Clave secreta para firmar Access Tokens (JWT de corta/media duración)
JWT_ACCESS_SECRET=dojo_jwt_access_secret_key_ultra_segura_2026_x99
# Clave secreta para firmar Refresh Tokens (Sesión persistente en Android/Web)
JWT_REFRESH_SECRET=dojo_jwt_refresh_secret_key_persistente_2026_z88
# Tiempo de expiración del Access Token (ej. 12 horas para operación continua)
JWT_ACCESS_EXPIRES_IN=12h
# Tiempo de expiración del Refresh Token (ej. 365 días para sesión iniciada por defecto en Android)
JWT_REFRESH_EXPIRES_IN=365d
# Clave interna para comunicación segura entre microservicios (Service-to-Service)
INTERNAL_SERVICE_API_KEY=internal_dojo_microservices_shared_key_2026

# ------------------------------------------------------------------------------
# 4. PUERTOS DE LOS MICROSERVICIOS Y FRONTEND
# ------------------------------------------------------------------------------
# Puerto público del API Gateway (Punto único de entrada para Web y Android)
API_GATEWAY_PORT=8080
# Puerto del Microservicio de Autenticación, Roles y Auditoría Inmutable
AUTH_AUDIT_SERVICE_PORT=3001
# Puerto del Microservicio de Estudiantes, Cinturones, Documentos y OCR
STUDENTS_DOCS_SERVICE_PORT=3002
# Puerto del Microservicio de Mensualidades y Semáforo de Estado
MEMBERSHIPS_SERVICE_PORT=3003
# Puerto del Microservicio de Asistencia, Historial de Clases y Geofencing GPS
ATTENDANCE_CLASSES_SERVICE_PORT=3004
# Puerto del Microservicio de Notificaciones Push y Alertas Locales
NOTIFICATIONS_SERVICE_PORT=3005
# Puerto público del servidor Frontend Web (Angular + Nginx)
FRONTEND_WEB_PORT=4200

# ------------------------------------------------------------------------------
# 5. URLS INTERNAS DE COMUNICACIÓN ENTRE MICROSERVICIOS (DOCKER NETWORK)
# ------------------------------------------------------------------------------
AUTH_AUDIT_SERVICE_URL=http://auth-audit-service:3001
STUDENTS_DOCS_SERVICE_URL=http://students-docs-service:3002
MEMBERSHIPS_SERVICE_URL=http://memberships-service:3003
ATTENDANCE_CLASSES_SERVICE_URL=http://attendance-classes-service:3004
NOTIFICATIONS_SERVICE_URL=http://notifications-service:3005

# ------------------------------------------------------------------------------
# 6. PARÁMETROS DE NEGOCIO: MENSUALIDADES Y SEMÁFORO VISUAL
# ------------------------------------------------------------------------------
# Duración estándar en días de un ciclo de mensualidad al confirmar pago
MEMBERSHIP_CYCLE_DAYS=30
# Umbral de días restantes para pasar el semáforo de VERDE a AMARILLO/NARANJA
MEMBERSHIP_WARNING_THRESHOLD_DAYS=5

# ------------------------------------------------------------------------------
# 7. PARÁMETROS DE GEOFENCING (DETECCIÓN AUTOMÁTICA DE CLASE EN ANDROID)
# ------------------------------------------------------------------------------
# Latitud central de la sede física del Dojo (Ejemplo: Bogotá, Colombia)
DOJO_GPS_LATITUDE=4.6533326
# Longitud central de la sede física del Dojo
DOJO_GPS_LONGITUDE=-74.083652
# Radio máximo permitido en metros alrededor del Dojo para considerar presencia
DOJO_GEOFENCE_RADIUS_METERS=50
# Tiempo continuo mínimo en minutos dentro del Dojo para marcar asistencia auto_gps
DOJO_MIN_DWELL_TIME_MINUTES=15

# ------------------------------------------------------------------------------
# 8. ALMACENAMIENTO DE ARCHIVOS Y MOTOR OCR (CÉDULA / EPS / FOTOS)
# ------------------------------------------------------------------------------
# Ruta interna del volumen compartido para almacenar Fotos, Cédulas y EPS
UPLOADS_STORAGE_PATH=/app/storage/uploads
# Tamaño máximo permitido por archivo subido en Megabytes (MB)
MAX_FILE_UPLOAD_SIZE_MB=10
# Idioma configurado para el motor Tesseract OCR (spa = Español)
OCR_LANGUAGE=spa
